# Copy to .env next to server.py, then restart the server. Keep real keys on the server.
# Fast route uses DeepSeek by default. FAST_API_KEY overrides DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
FAST_BASE_URL=https://api.deepseek.com
FAST_MODEL=deepseek-flash
# Retail prices in CNY per 1,000,000 tokens; set to your own tariff.
FAST_INPUT_RATE=3
FAST_OUTPUT_RATE=6

# OpenAI chat/completions-compatible endpoint; include /v1 if your provider requires it.
ECONOMY_BASE_URL=
ECONOMY_MODEL=
ECONOMY_API_KEY=
ECONOMY_INPUT_RATE=1
ECONOMY_OUTPUT_RATE=2

# Stripe checkout (see PAYMENTS.md). Leave blank for demo.
PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional absolute SQLite file path. Default is data/chaoxi.sqlite3 in this folder.
DATABASE_PATH=
